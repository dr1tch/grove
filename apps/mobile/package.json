{
  "name": "@grove/mobile",
  "version": "0.1.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "predev": "pnpm editor",
    "editor": "node scripts/build-editor.mjs",
    "typecheck": "pnpm editor && tsc --noEmit",
    "build": "pnpm editor && expo export --platform all --output-dir ../../out/mobile",
    "build:web": "pnpm editor && expo export --platform web --output-dir ../../out/mobile-web"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/source-serif-4": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@grove/core": "workspace:*",
    "@grove/github-vault": "workspace:*",
    "@lezer/highlight": "^1.2.5",
    "@supabase/supabase-js": "^2.119.0",
    "dompurify": "^3.4.18",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-auth-session": "~58.0.18",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "lucide-react-native": "^1.73.0",
    "mermaid": "^12.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "~6.0.3",
    "vite-plus": "^1.6.0"
  }
}
