{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite-plus/client"]
  },
  "include": [
    "src",
    "*.config.ts",
    "packages/core/src",
    "apps/landing/src",
    "apps/landing/vite.config.ts",
    "packages/github-vault/src",
    "apps/web/src"
  ]
}
